[include]
	path = ~/.gitconfig.local

# Work identity and remotes. Adjust or add directories to match where work
# repositories live; a missing file is ignored, so this is safe by default.
[includeIf "gitdir:~/Documents/neoAI/"]
	path = ~/.gitconfig.work

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	ff = only

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[diff]
	algorithm = histogram
	colorMoved = zebra

[column]
	ui = auto

[branch]
	sort = -committerdate
