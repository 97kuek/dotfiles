# Never commit private keys. Only this file is tracked; keys and any host that
# should stay private belong in ~/.ssh/config.d/*.conf, which Git ignores.

# Machine-local and private hosts. Must stay first: for most options ssh keeps
# the first value it sees, so an override here wins over the defaults below.
Include ~/.ssh/config.d/*.conf

# IdentityFile is deliberately kept out of "Host *": IdentityFile entries
# accumulate across every matching block, so a default there would offer the
# same key to every host. Pin it per host instead.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# --- Defaults ----------------------------------------------------------------
Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
