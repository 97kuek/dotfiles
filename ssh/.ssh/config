# Never commit private keys. Only this file is tracked; keys and any host that
# should stay private belong in ~/.ssh/config.d/*.conf, which Git ignores.

# Machine-local and private hosts. Must stay first: for most options ssh keeps
# the first value it sees, so an override here wins over the defaults below.
Include ~/.ssh/config.d/*.conf

# --- GitHub accounts ---------------------------------------------------------
# Each account gets its own alias so the right key is used. IdentityFile is
# deliberately NOT set under "Host *": IdentityFile entries accumulate across
# matching blocks, so a default there would let the personal key leak into the
# work connection even with IdentitiesOnly.

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Clone with: git clone github-work:org/repo.git
Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes

# --- Defaults ----------------------------------------------------------------
Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
